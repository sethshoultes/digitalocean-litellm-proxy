# Application Environment
ENVIRONMENT=development
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_PREFIX=/api/v1

# Security Settings
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Database Configuration  
DATABASE_URL=postgresql+asyncpg://litellm_user:litellm_password@localhost:5432/litellm_connection_management
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

# Cache Settings
CACHE_TTL_SECONDS=300
CACHE_PREFIX=litellm_cm:

# CORS Settings
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging and Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# LiteLLM Integration
LITELLM_MASTER_KEY=sk-your-master-key-here
LITELLM_CONFIG_PATH=litellm-config.yaml
LITELLM_PROXY_URL=http://localhost:4000

# External API Keys (for testing and validation)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Activity Tracking
ENABLE_ACTIVITY_TRACKING=true
ACTIVITY_BATCH_SIZE=100
ACTIVITY_FLUSH_INTERVAL=10

# Cleanup and Maintenance
CLEANUP_OLD_ACTIVITIES_DAYS=90
SUMMARY_GENERATION_ENABLED=true
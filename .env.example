# LiteLLM API Keys - Copy to .env and add your real keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Database Configuration
DATABASE_URL=postgresql://litellm_user:litellm_password@localhost:5432/litellm_connection_management
REDIS_URL=redis://localhost:6379

# Application Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
LITELLM_CONNECTION_ENCRYPTION_KEY=your-32-character-encryption-key

# Optional: LiteLLM Master Key
LITELLM_MASTER_KEY=sk-your-master-key

# Environment
ENVIRONMENT=development